{
  "name": "moonnryan-research-workshop-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-content.mjs && vitepress build content",
    "build:preview": "node scripts/prepare-content.mjs --preview && vitepress build content",
    "preview": "vitepress preview content --host 127.0.0.1",
    "check": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "mermaid": "11.12.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "4.3.2",
    "vitepress": "1.6.4"
  }
}
